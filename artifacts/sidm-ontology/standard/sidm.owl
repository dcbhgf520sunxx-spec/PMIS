>
  <rdf:Description rdf:about="urn:sidm:ontology:stageContract">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">付款阶段归属合同</rdfs:label>
    <rdfs:domain rdf:resource="urn:sidm:ontology:PaymentStage"/>
    <rdfs:range rdf:resource="urn:sidm:ontology:ProjectContract"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:serviceStartOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">服务开始日期</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <s:sourceGranularity>date</s:sourceGranularity>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:belongsToProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">直接归属项目</rdfs:label>
    <rdfs:domain rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b36"/>
    <rdfs:range rdf:resource="urn:sidm:ontology:Project"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b96">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="urn:sidm:ontology:belongsToProject"/>
    <owl:someValuesFrom rdf:resource="urn:sidm:ontology:Project"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:relatedProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">关联产品</rdfs:label>
    <rdfs:range rdf:resource="urn:sidm:ontology:Product"/>
    <rdfs:comment xml:lang="zh">通过直接归属追溯产品，不替代直接归属关系</rdfs:comment>
    <owl:propertyChainAxiom rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b85"/>
    <owl:propertyChainAxiom rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b87"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b91">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="urn:sidm:ontology:belongsToRequirement"/>
    <owl:someValuesFrom rdf:resource="urn:sidm:ontology:Requirement"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:actualEndOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">实际完成日期</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <s:sourceGranularity>date</s:sourceGranularity>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b109">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="urn:sidm:ontology:belongsToProject"/>
    <owl:someValuesFrom rdf:resource="urn:sidm:ontology:Project"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:itemStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">事项归属阶段</rdfs:label>
    <rdfs:domain rdf:resource="urn:sidm:ontology:KeyItem"/>
    <rdfs:range rdf:resource="urn:sidm:ontology:ProjectStage"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:plannedAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">计划付款金额</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b67">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="urn:sidm:ontology:owner"/>
    <owl:someValuesFrom rdf:resource="urn:sidm:ontology:Person"/>
