    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">归属产品</rdfs:label>
    <rdfs:domain rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b16"/>
