  <rdf:Description rdf:about="urn:sidm:ontology:Task">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">任务及子任务</rdfs:label>
    <rdfs:comment xml:lang="zh">具体执行工作及其拆分；子任务仍是任务，通过父任务关系表达</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b34"/>
    <rdfs:subClassOf rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b39"/>
    <rdfs:subClassOf rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b45"/>
