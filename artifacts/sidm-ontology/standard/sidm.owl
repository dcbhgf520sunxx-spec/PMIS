  <rdf:Description rdf:about="urn:sidm:ontology:Project">
    <s:completionRule xml:lang="zh">按项目自身状态判断：已完成算完成，未开始、进行中、已暂停算未完成。
项目已关闭或来源需求已关闭不参与；项目下属工作同样退出统计，恢复后重新筛选。</s:completionRule>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">项目</rdfs:label>
    <rdfs:comment xml:lang="zh">由需求转化而来、组织实施的建设工作</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b23"/>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b24"/>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b29"/>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b30"/>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b69"/>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b70"/>
  </rdf:Description>
