  <rdf:Description rdf:about="urn:sidm:ontology:MaintenanceContract">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">产品运维合同</rdfs:label>
    <rdfs:comment xml:lang="zh">产品持续运维服务的商务约定</rdfs:comment>
    <rdfs:comment xml:lang="zh">运维合同录入即表示已付款；合同金额按已付款金额表达，不另设运维付款阶段和付款明细。</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b27"/>
    <rdfs:subClassOf rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b28"/>
