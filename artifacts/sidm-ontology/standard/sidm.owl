  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:ProjectStage">
    <s:completionRule xml:lang="zh">阶段内全部关键事项已完成才算完成；有事项尚未完成（包括暂停）算未完成。没有事项或上级关闭不参与。
项目阶段无独立负责人及计划完成日期，仅按事项汇总判定，不自动推定个人考核归属。</s:completionRule>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">项目阶段</rdfs:label>
    <rdfs:comment xml:lang="zh">按需划分的项目实施过程</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b41"/>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b42"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:belongsToProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">直接归属项目</rdfs:label>
    <rdfs:domain rdf:nodeID="n5ef238332bab410f99954754c4070e85b36"/>
    <rdfs:range rdf:resource="urn:sidm:ontology:Project"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n5ef238332bab410f99954754c4070e85b104">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="urn:sidm:ontology:belongsToRequirement"/>
    <owl:someValuesFrom rdf:resource="urn:sidm:ontology:Requirement"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:WorkOrder">
    <s:completionRule xml:lang="zh">已解决算完成；待处理、处理中、已暂停、被激活算未完成；已关闭不参与。个人统计取当前跟进人，按预计解决时间归期。</s:completionRule>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="zh">运维工单</rdfs:label>
    <rdfs:comment xml:lang="zh">产品使用中的问题处理记录</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b25"/>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b26"/>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b76"/>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b77"/>
    <rdfs:subClassOf rdf:nodeID="n5ef238332bab410f99954754c4070e85b84"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:severity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">严重程度</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:hasProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">关联项目</rdfs:label>
    <owl:inverseOf rdf:resource="urn:sidm:ontology:sourceRequirement"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="urn:sidm:ontology:version:1.0.3"/>
    <rdfs:label xml:lang="zh">SIDM业务本体</rdfs:label>
    <owl:versionInfo>1.0.3</owl:versionInfo>
    <rdfs:comment xml:lang="zh">正式OWL 2 DL模型；基于已确认业务骨架。缺失信息采用开放世界语义，数据完整性由SHACL检查。</rdfs:comment>
    <s:completionFormula xml:lang="zh">完成率＝本期已完成单据数 ÷ 本期纳入统计的单据数 × 100%。按单据类别分别统计，部分完成不折算完成数量，也不平均单据进度；没有符合条件的单据时显示“—”。</s:completionFormula>
    <s:completionScope xml:lang="zh">先排除不参与的单据，再判断完成或未完成，并按个人责任范围与考核期筛选。需求、项目或主任务关闭，其下属工作退出统计；恢复后重新筛选，记录和状态保留。暂停不退出统计。产品、供应商、项目合同、付款阶段、付款记录、产品运维合同不计算完成率。</s:completionScope>
    <s:completionOwnership xml:lang="zh">只按当前责任角色统计：需求、项目、关键事项取当前负责人，任务取当前负责人名单，BUG取当前处理人，工单取当前跟进人。历史责任人不追溯，完成后换人也按当前责任人统计；多人负责分别计入各自个人统计。协作人、普通成员、提出人、创建人不自动计入。主子任务合为一个任务类别，个人去重规则见任务说明。</s:completionOwnership>
    <s:completionPeriod xml:lang="zh">按最新计划完成日期归期，不使用原定日期；无计划日期不计入，BUG除外。
当期包括本期计划完成的工作，以及期初已逾期但仍未完成的工作。遗留工作进入当期分母，完成则进入分子，未完成继续结转下一期；关闭排除规则照常适用。
BUG当期范围为期初尚未关闭的，以及本期新增或重新激活的；同一BUG每期只计一次。
已结束考核期按期末判断完成；未结束考核期按统计当天判断，后来完成不倒算到前期。</s:completionPeriod>
    <s:completionEvidence xml:lang="zh">结果保留完成数、统计数及对应单据清单。历史完成结果、需求有效结论和BUG重新激活须有业务日期或历史记录支持；数据不足标记“待核实”，不以更新时间推定完成。当前状态快照与未完成工作清单不能直接代替个人历史考核统计。本体中的口径说明不表示已经实现自动计算或通过数据校验。</s:completionEvidence>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n5ef238332bab410f99954754c4070e85b4">
    <rdf:first rdf:resource="urn:sidm:ontology:Project"/>
    <rdf:rest rdf:nodeID="n5ef238332bab410f99954754c4070e85b5"/>
  </rdf:Description>
