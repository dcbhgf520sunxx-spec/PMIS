  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">业务说明</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:hasProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="zh">关联项目</rdfs:label>
    <owl:inverseOf rdf:resource="urn:sidm:ontology:sourceRequirement"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">名称</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf0569c97aeb3466fb298a56e668bb510b77">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="urn:sidm:ontology:follower"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:submittedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">提出时间</rdfs:label>
