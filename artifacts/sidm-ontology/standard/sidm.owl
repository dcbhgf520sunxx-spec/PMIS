    <owl:onProperty rdf:resource="urn:sidm:ontology:sourceRequirement"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n5ef238332bab410f99954754c4070e85b105">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="urn:sidm:ontology:belongsToProject"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:sourceType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="zh">任务关联类型</rdfs:label>
    <rdfs:domain rdf:resource="urn:sidm:ontology:Task"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="zh">项目、需求、日常任务；日常任务不关联项目或需求</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n5ef238332bab410f99954754c4070e85b23">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="urn:sidm:ontology:belongsToProduct"/>
    <owl:someValuesFrom rdf:resource="urn:sidm:ontology:Product"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sidm:ontology:completionPeriod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
