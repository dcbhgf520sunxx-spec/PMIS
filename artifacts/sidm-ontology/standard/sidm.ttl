@prefix s: <urn:sidm:ontology:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .


<urn:sidm:ontology> a owl:Ontology ; owl:versionIRI <urn:sidm:ontology:version:1.0.3> ;
 rdfs:label "SIDM业务本体"@zh ; owl:versionInfo "1.0.3" ;
 rdfs:comment "正式OWL 2 DL模型；基于已确认业务骨架。缺失信息采用开放世界语义，数据完整性由SHACL检查。"@zh .

# 已确认的个人考核口径；注释定义不新增业务字段，也不改变业务状态或SHACL写入约束。
s:completionRule a owl:AnnotationProperty ; rdfs:label "本类单据的完成判定"@zh .
s:completionFormula a owl:AnnotationProperty ; rdfs:label "计算公式"@zh .
s:completionScope a owl:AnnotationProperty ; rdfs:label "统计范围"@zh .
s:completionOwnership a owl:AnnotationProperty ; rdfs:label "个人归属"@zh .
s:completionPeriod a owl:AnnotationProperty ; rdfs:label "考核期与归期"@zh .
s:completionEvidence a owl:AnnotationProperty ; rdfs:label "结果与证据"@zh .

<urn:sidm:ontology>
 s:completionFormula "完成率＝本期已完成单据数 ÷ 本期纳入统计的单据数 × 100%。按单据类别分别统计，部分完成不折算完成数量，也不平均单据进度；没有符合条件的单据时显示“—”。"@zh ;
 s:completionScope "先排除不参与的单据，再判断完成或未完成，并按个人责任范围与考核期筛选。需求、项目或主任务关闭，其下属工作退出统计；恢复后重新筛选，记录和状态保留。暂停不退出统计。产品、供应商、项目合同、付款阶段、付款记录、产品运维合同不计算完成率。"@zh ;
 s:completionOwnership "只按当前责任角色统计：需求、项目、关键事项取当前负责人，任务取当前负责人名单，BUG取当前处理人，工单取当前跟进人。历史责任人不追溯，完成后换人也按当前责任人统计；多人负责分别计入各自个人统计。协作人、普通成员、提出人、创建人不自动计入。主子任务合为一个任务类别，个人去重规则见任务说明。"@zh ;
 s:completionPeriod """按最新计划完成日期归期，不使用原定日期；无计划日期不计入，BUG除外。
当期包括本期计划完成的工作，以及期初已逾期但仍未完成的工作。遗留工作进入当期分母，完成则进入分子，未完成继续结转下一期；关闭排除规则照常适用。
BUG当期范围为期初尚未关闭的，以及本期新增或重新激活的；同一BUG每期只计一次。
已结束考核期按期末判断完成；未结束考核期按统计当天判断，后来完成不倒算到前期。"""@zh ;
 s:completionEvidence "结果保留完成数、统计数及对应单据清单。历史完成结果、需求有效结论和BUG重新激活须有业务日期或历史记录支持；数据不足标记“待核实”，不以更新时间推定完成。当前状态快照与未完成工作清单不能直接代替个人历史考核统计。本体中的口径说明不表示已经实现自动计算或通过数据校验。"@zh .

s:Requirement s:completionRule """上会立项、需求提报、预研需求：按各自路径得出有效结论，通过或未通过均算完成；得出结论后，后续实施、试运行或暂停仍算完成。
重新评估、重新审批或重新预研后，原结论不再作为完成依据，按新一轮结论重新判断；有效结论须有业务日期或历史记录支持，资料不足标记“待核实”。
直接实施需求：已完成或已完成未使用算完成；尚未完成（包括暂停）算未完成。
已转项目：需求转交算完成，关联项目独立统计，不据此认定项目实施已完成。
需求已关闭不参与，其下属工作退出统计；恢复后重新筛选。"""@zh .
s:Project s:completionRule """按项目自身状态判断：已完成算完成，未开始、进行中、已暂停算未完成。
项目已关闭或来源需求已关闭不参与；项目下属工作同样退出统计，恢复后重新筛选。"""@zh .
s:Task s:completionRule """无子任务的任务及子任务：已完成算完成，待处理、处理中、已暂停算未完成，已关闭不参与。
有子任务的主任务：所有未关闭子任务均已完成才算完成；存在未关闭且尚未完成的子任务算未完成，不增加主任务完成确认。
主任务关闭，或全部子任务关闭时，主任务不参与；主任务关闭，其下属子任务也退出统计。上级需求或项目关闭同样退出统计，恢复后重新筛选。
主任务和子任务合为一个任务类别，按个人去重：只负责主任务则统计主任务；只负责子任务则统计本人负责的子任务；同时负责主任务和其中的子任务，只统计本人负责的子任务。"""@zh .
s:ProjectStage s:completionRule """阶段内全部关键事项已完成才算完成；有事项尚未完成（包括暂停）算未完成。没有事项或上级关闭不参与。
项目阶段无独立负责人及计划完成日期，仅按事项汇总判定，不自动推定个人考核归属。"""@zh .
s:KeyItem s:completionRule "已完成算完成；未开始、进行中、已暂停算未完成；上级项目或来源需求关闭不参与。个人统计取当前负责人，归期取当前计划完成日期，不使用原定日期。"@zh .
s:Bug s:completionRule """已关闭算完成；新建、已修复、被激活算未完成。BUG关闭表示缺陷处理完成，与任务、项目等取消关闭的含义不同。
所属需求或项目关闭不参与，所属项目的来源需求关闭同样退出统计。
没有计划完成日期，不推定到期日；按期初未关闭、本期新增或重新激活纳入，同一BUG每期只计一次，重新激活须有历史证据。"""@zh .
s:WorkOrder s:completionRule "已解决算完成；待处理、处理中、已暂停、被激活算未完成；已关闭不参与。个人统计取当前跟进人，按预计解决时间归期。"@zh .
s:Product s:completionRule "产品不计算完成率。"@zh .
s:Supplier s:completionRule "供应商不计算完成率。"@zh .
s:ProjectContract s:completionRule "项目合同不计算完成率；付款情况按合同与付款记录口径另行分析。"@zh .
s:PaymentStage s:completionRule "付款阶段不计算完成率；付款阶段与项目实施阶段分别定义。"@zh .
s:PaymentRecord s:completionRule "付款记录不计算完成率。"@zh .
s:MaintenanceContract s:completionRule "产品运维合同不计算完成率。"@zh .
s:Person s:completionRule "人员是个人统计的归属维度，不作为单据计入完成率。仅计当前承担责任的单据，普通成员或协作身份不自动计入。"@zh .


s:Product a owl:Class ; rdfs:label "产品"@zh ; rdfs:comment "持续建设、使用和维护的数字化对象"@zh .

s:Requirement a owl:Class ; rdfs:label "需求"@zh ; rdfs:comment "希望解决的问题或实现的改变"@zh .

s:Project a owl:Class ; rdfs:label "项目"@zh ; rdfs:comment "由需求转化而来、组织实施的建设工作"@zh .

s:ProjectStage a owl:Class ; rdfs:label "项目阶段"@zh ; rdfs:comment "按需划分的项目实施过程"@zh .

s:KeyItem a owl:Class ; rdfs:label "关键事项"@zh ; rdfs:comment "阶段内需要关注的重要工作节点"@zh .

s:Task a owl:Class ; rdfs:label "任务及子任务"@zh ; rdfs:comment "具体执行工作及其拆分；项目/需求任务关联对应对象，日常任务独立存在；子任务继承主任务的关联类型和对象"@zh .

s:sourceType a owl:DatatypeProperty ; rdfs:label "任务关联类型"@zh ; rdfs:domain s:Task ; rdfs:range xsd:string ; rdfs:comment "项目、需求、日常任务；日常任务不关联项目或需求"@zh .

s:Bug a owl:Class ; rdfs:label "BUG"@zh ; rdfs:comment "建设过程中的软件缺陷记录"@zh .

s:ProjectContract a owl:Class ; rdfs:label "项目合同"@zh ; rdfs:comment "项目建设中的商务约定"@zh .

s:PaymentStage a owl:Class ; rdfs:label "付款阶段"@zh ; rdfs:comment "项目合同金额的分阶段安排"@zh .

s:PaymentRecord a owl:Class ; rdfs:label "付款记录"@zh ; rdfs:comment "实际付款后登记的金额、月份及经办信息"@zh .

s:MaintenanceContract a owl:Class ; rdfs:label "产品运维合同"@zh ; rdfs:comment "产品持续运维服务的商务约定"@zh .

s:WorkOrder a owl:Class ; rdfs:label "运维工单"@zh ; rdfs:comment "产品使用中的问题处理记录"@zh .

s:Supplier a owl:Class ; rdfs:label "供应商"@zh ; rdfs:comment "提供建设或运维服务的合作方"@zh .

s:Person a owl:Class ; rdfs:label "人员"@zh ; rdfs:comment "承担具体业务责任和参与工作的人员"@zh .

[] a owl:AllDisjointClasses ; owl:members ( s:Product s:Requirement s:Project s:ProjectStage s:KeyItem s:Task s:Bug s:ProjectContract s:PaymentStage s:PaymentRecord s:MaintenanceContract s:WorkOrder s:Supplier s:Person ) .

s:belongsToProduct a owl:ObjectProperty ; rdfs:label "归属产品"@zh ; rdfs:domain [ a owl:Class ; owl:unionOf ( s:Requirement s:Project s:WorkOrder s:MaintenanceContract ) ] ; rdfs:range s:Product .

s:Requirement rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToProduct ; owl:someValuesFrom s:Product ] .

s:Requirement rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToProduct ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:Project rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToProduct ; owl:someValuesFrom s:Product ] .

s:Project rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToProduct ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:WorkOrder rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToProduct ; owl:someValuesFrom s:Product ] .

s:WorkOrder rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToProduct ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:MaintenanceContract rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToProduct ; owl:someValuesFrom s:Product ] .

s:MaintenanceContract rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToProduct ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:sourceRequirement a owl:ObjectProperty ; rdfs:label "来源需求"@zh ; rdfs:domain s:Project ; rdfs:range s:Requirement .

s:Project rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:sourceRequirement ; owl:someValuesFrom s:Requirement ] .

s:Project rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:sourceRequirement ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:belongsToRequirement a owl:ObjectProperty ; rdfs:label "直接归属需求"@zh ; rdfs:domain [ a owl:Class ; owl:unionOf ( s:Task s:Bug ) ] ; rdfs:range s:Requirement .

s:Task rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToRequirement ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:Bug rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToRequirement ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:belongsToProject a owl:ObjectProperty ; rdfs:label "直接归属项目"@zh ; rdfs:domain [ a owl:Class ; owl:unionOf ( s:Task s:Bug ) ] ; rdfs:range s:Project .

s:Task rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToProject ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:Bug rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:belongsToProject ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:stageProject a owl:ObjectProperty ; rdfs:label "阶段归属项目"@zh ; rdfs:domain s:ProjectStage ; rdfs:range s:Project .

s:ProjectStage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:stageProject ; owl:someValuesFrom s:Project ] .

s:ProjectStage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:stageProject ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:itemStage a owl:ObjectProperty ; rdfs:label "事项归属阶段"@zh ; rdfs:domain s:KeyItem ; rdfs:range s:ProjectStage .

s:KeyItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:itemStage ; owl:someValuesFrom s:ProjectStage ] .

s:KeyItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:itemStage ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:parentTask a owl:ObjectProperty ; rdfs:label "父任务"@zh ; rdfs:domain s:Task ; rdfs:range s:Task .

s:Task rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:parentTask ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:contractProject a owl:ObjectProperty ; rdfs:label "合同归属项目"@zh ; rdfs:domain s:ProjectContract ; rdfs:range s:Project .

s:ProjectContract rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:contractProject ; owl:someValuesFrom s:Project ] .

s:ProjectContract rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:contractProject ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:stageContract a owl:ObjectProperty ; rdfs:label "付款阶段归属合同"@zh ; rdfs:domain s:PaymentStage ; rdfs:range s:ProjectContract .

s:PaymentStage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:stageContract ; owl:someValuesFrom s:ProjectContract ] .

s:PaymentStage rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:stageContract ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:recordStage a owl:ObjectProperty ; rdfs:label "付款记录归属阶段"@zh ; rdfs:domain s:PaymentRecord ; rdfs:range s:PaymentStage .

s:PaymentRecord rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:recordStage ; owl:someValuesFrom s:PaymentStage ] .

s:PaymentRecord rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:recordStage ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:supplier a owl:ObjectProperty ; rdfs:label "供应商"@zh ; rdfs:domain [ a owl:Class ; owl:unionOf ( s:ProjectContract s:MaintenanceContract ) ] ; rdfs:range s:Supplier .

s:ProjectContract rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:supplier ; owl:someValuesFrom s:Supplier ] .

s:ProjectContract rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:supplier ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:MaintenanceContract rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:supplier ; owl:someValuesFrom s:Supplier ] .

s:MaintenanceContract rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:supplier ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:previousContract a owl:ObjectProperty ; rdfs:label "续签自"@zh ; rdfs:domain s:MaintenanceContract ; rdfs:range s:MaintenanceContract .

s:MaintenanceContract rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:previousContract ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:owner a owl:ObjectProperty ; rdfs:label "负责人"@zh ; rdfs:domain [ a owl:Class ; owl:unionOf ( s:Product s:Requirement s:Project s:KeyItem ) ] ; rdfs:range s:Person .

s:Product rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:owner ; owl:someValuesFrom s:Person ] .

s:Product rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:owner ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:Requirement rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:owner ; owl:someValuesFrom s:Person ] .

s:Requirement rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:owner ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:Project rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:owner ; owl:someValuesFrom s:Person ] .

s:Project rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:owner ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:KeyItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:owner ; owl:someValuesFrom s:Person ] .

s:KeyItem rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:owner ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:taskOwner a owl:ObjectProperty ; rdfs:label "任务负责人"@zh ; rdfs:domain s:Task ; rdfs:range s:Person .

s:Task rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:taskOwner ; owl:someValuesFrom s:Person ] .

s:member a owl:ObjectProperty ; rdfs:label "项目成员"@zh ; rdfs:domain s:Project ; rdfs:range s:Person .

s:collaborator a owl:ObjectProperty ; rdfs:label "事项协作人"@zh ; rdfs:domain s:KeyItem ; rdfs:range s:Person .

s:assignee a owl:ObjectProperty ; rdfs:label "BUG处理人"@zh ; rdfs:domain s:Bug ; rdfs:range s:Person .

s:Bug rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:assignee ; owl:someValuesFrom s:Person ] .

s:Bug rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:assignee ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:follower a owl:ObjectProperty ; rdfs:label "工单跟进人"@zh ; rdfs:domain s:WorkOrder ; rdfs:range s:Person .

s:WorkOrder rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:follower ; owl:someValuesFrom s:Person ] .

s:WorkOrder rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:follower ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:handler a owl:ObjectProperty ; rdfs:label "付款经办人"@zh ; rdfs:domain s:PaymentRecord ; rdfs:range s:Person .

s:PaymentRecord rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:handler ; owl:someValuesFrom s:Person ] .

s:PaymentRecord rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:handler ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:submitter a owl:ObjectProperty ; rdfs:label "提出人"@zh ; rdfs:domain [ a owl:Class ; owl:unionOf ( s:Requirement s:WorkOrder ) ] ; rdfs:range s:Person .

s:Requirement rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:submitter ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:WorkOrder rdfs:subClassOf [ a owl:Restriction ; owl:onProperty s:submitter ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

s:name a owl:DatatypeProperty ; rdfs:label "名称"@zh ; rdfs:range xsd:string .

s:description a owl:DatatypeProperty ; rdfs:label "业务说明"@zh ; rdfs:range xsd:string .

s:requirementType a owl:DatatypeProperty ; rdfs:label "需求类型"@zh ; rdfs:range xsd:string .

s:submitterName a owl:DatatypeProperty ; rdfs:label "提出人姓名"@zh ; rdfs:range xsd:string .

s:submitterDepartment a owl:DatatypeProperty ; rdfs:label "提出部门"@zh ; rdfs:range xsd:string .

s:submittedOn a owl:DatatypeProperty ; rdfs:label "提出日期"@zh ; rdfs:range xsd:dateTime .

s:priority a owl:DatatypeProperty ; rdfs:label "优先级"@zh ; rdfs:range xsd:string .

s:startOn a owl:DatatypeProperty ; rdfs:label "开始日期"@zh ; rdfs:range xsd:dateTime .

s:expectedEndOn a owl:DatatypeProperty ; rdfs:label "预计完成日期"@zh ; rdfs:range xsd:dateTime .

s:actualEndOn a owl:DatatypeProperty ; rdfs:label "实际完成日期"@zh ; rdfs:range xsd:dateTime .

s:status a owl:DatatypeProperty ; rdfs:label "状态"@zh ; rdfs:range xsd:string .

s:pauseReason a owl:DatatypeProperty ; rdfs:label "暂停原因"@zh ; rdfs:range xsd:string .

s:pausedAt a owl:DatatypeProperty ; rdfs:label "暂停时间"@zh ; rdfs:range xsd:dateTime .

s:progress a owl:DatatypeProperty ; rdfs:label "进展记录"@zh ; rdfs:range xsd:string .

s:risk a owl:DatatypeProperty ; rdfs:label "风险记录"@zh ; rdfs:range xsd:string .

s:order a owl:DatatypeProperty ; rdfs:label "排列顺序"@zh ; rdfs:range xsd:integer .

s:originalDueOn a owl:DatatypeProperty ; rdfs:label "原定完成日期"@zh ; rdfs:range xsd:dateTime .

s:currentDueOn a owl:DatatypeProperty ; rdfs:label "当前计划日期"@zh ; rdfs:range xsd:dateTime .

s:deliveryRequirement a owl:DatatypeProperty ; rdfs:label "交付要求"@zh ; rdfs:range xsd:string .

s:taskType a owl:DatatypeProperty ; rdfs:label "任务类型"@zh ; rdfs:range xsd:string .

s:bugType a owl:DatatypeProperty ; rdfs:label "缺陷类型"@zh ; rdfs:range xsd:string .

s:severity a owl:DatatypeProperty ; rdfs:label "严重程度"@zh ; rdfs:range xsd:string .

s:resolution a owl:DatatypeProperty ; rdfs:label "解决方案"@zh ; rdfs:range xsd:string .

s:resolvedOn a owl:DatatypeProperty ; rdfs:label "修复时间"@zh ; rdfs:range xsd:dateTime .

s:closedOn a owl:DatatypeProperty ; rdfs:label "关闭时间"@zh ; rdfs:range xsd:dateTime .

s:activationReason a owl:DatatypeProperty ; rdfs:label "激活原因"@zh ; rdfs:range xsd:string .

s:code a owl:DatatypeProperty ; rdfs:label "合同编号"@zh ; rdfs:range xsd:string .

s:signedOn a owl:DatatypeProperty ; rdfs:label "签订日期"@zh ; rdfs:range xsd:dateTime .

s:amount a owl:DatatypeProperty ; rdfs:label "金额"@zh ; rdfs:range xsd:decimal .

s:plannedAmount a owl:DatatypeProperty ; rdfs:label "计划付款金额"@zh ; rdfs:range xsd:decimal .

s:paymentMonth a owl:DatatypeProperty ; rdfs:label "付款月份"@zh ; rdfs:range xsd:string .

s:serviceStartOn a owl:DatatypeProperty ; rdfs:label "服务开始日期"@zh ; rdfs:range xsd:dateTime .

s:serviceEndOn a owl:DatatypeProperty ; rdfs:label "服务结束日期"@zh ; rdfs:range xsd:dateTime .

s:terminationOn a owl:DatatypeProperty ; rdfs:label "终止日期"@zh ; rdfs:range xsd:dateTime .

s:terminationReason a owl:DatatypeProperty ; rdfs:label "终止原因"@zh ; rdfs:range xsd:string .

s:problemType a owl:DatatypeProperty ; rdfs:label "问题类型"@zh ; rdfs:range xsd:string .

s:urgency a owl:DatatypeProperty ; rdfs:label "紧急程度"@zh ; rdfs:range xsd:string .

s:submittedAt a owl:DatatypeProperty ; rdfs:label "提出时间"@zh ; rdfs:range xsd:dateTime .

s:expectedResolveAt a owl:DatatypeProperty ; rdfs:label "预计解决时间"@zh ; rdfs:range xsd:dateTime .

s:resolvedAt a owl:DatatypeProperty ; rdfs:label "实际解决时间"@zh ; rdfs:range xsd:dateTime .

s:result a owl:DatatypeProperty ; rdfs:label "处理结果"@zh ; rdfs:range xsd:string .

s:hasProject a owl:ObjectProperty ; rdfs:label "关联项目"@zh ; owl:inverseOf s:sourceRequirement .

s:relatedProduct a owl:ObjectProperty ; rdfs:label "关联产品"@zh ; rdfs:range s:Product ; rdfs:comment "通过直接归属追溯产品，不替代直接归属关系"@zh ; owl:propertyChainAxiom ( s:belongsToProject s:belongsToProduct ), ( s:belongsToRequirement s:belongsToProduct ) .

s:Task rdfs:subClassOf [ a owl:Class ; owl:unionOf ( [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty s:belongsToRequirement ; owl:someValuesFrom s:Requirement ] [ a owl:Restriction ; owl:onProperty s:belongsToProject ; owl:maxCardinality "0"^^xsd:nonNegativeInteger ] ) ] [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty s:belongsToProject ; owl:someValuesFrom s:Project ] [ a owl:Restriction ; owl:onProperty s:belongsToRequirement ; owl:maxCardinality "0"^^xsd:nonNegativeInteger ] ) ] ) ] .

s:Bug rdfs:subClassOf [ a owl:Class ; owl:unionOf ( [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty s:belongsToRequirement ; owl:someValuesFrom s:Requirement ] [ a owl:Restriction ; owl:onProperty s:belongsToProject ; owl:maxCardinality "0"^^xsd:nonNegativeInteger ] ) ] [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty s:belongsToProject ; owl:someValuesFrom s:Project ] [ a owl:Restriction ; owl:onProperty s:belongsToRequirement ; owl:maxCardinality "0"^^xsd:nonNegativeInteger ] ) ] ) ] .

# Provenance annotations do not add business object classes.
s:sourceId a owl:AnnotationProperty .
s:sourceEnvironment a owl:AnnotationProperty .
s:sourceCapturedAt a owl:AnnotationProperty .
s:sourceEndpoint a owl:AnnotationProperty .
s:sourceSnapshot a owl:AnnotationProperty .
s:datasetKind a owl:AnnotationProperty .
s:sourceGranularity a owl:AnnotationProperty .
s:startOn s:sourceGranularity "date" .
s:expectedEndOn s:sourceGranularity "date" .
s:actualEndOn s:sourceGranularity "date" .
s:signedOn s:sourceGranularity "date" .
s:serviceStartOn s:sourceGranularity "date" .
s:serviceEndOn s:sourceGranularity "date" .
s:originalDueOn s:sourceGranularity "date" .
s:currentDueOn s:sourceGranularity "date" .
s:paymentMonth s:sourceGranularity "yearMonth" .
s:paymentsComplete a owl:AnnotationProperty ; rdfs:comment "该次样本已读取指定合同或阶段全部付款；仅凭无明细不能设置为true"@zh .
s:sourceScope a owl:AnnotationProperty .
s:sourceConsistency a owl:AnnotationProperty .
s:unresolvedRelations a owl:AnnotationProperty .

# 用户确认的业务口径：运维合同录入表示已付款，项目合同仍使用付款明细。
s:MaintenanceContract rdfs:comment "运维合同录入即表示已付款；合同金额按已付款金额表达，不另设运维付款阶段和付款明细。"@zh .
