PORT=3103
DB_HOST=localhost
DB_PORT=5433
DB_USER=pms
DB_PASSWORD=pms123456
DB_NAME=pmis
JWT_SECRET=your_jwt_secret_key_change_this
ALLOWED_ORIGIN=http://localhost:3104

# 企业微信工作台单点登录
WECOM_CORP_ID=ww_your_corp_id
WECOM_AGENT_ID=your_agent_id
WECOM_SECRET=your_wecom_app_secret
WECOM_USER_ID_URL=http://your-internal-service/shr/person/getWxUserId
WECOM_CALLBACK_URL=https://your-domain.com/api/auth/wecom/callback
WECOM_FRONTEND_URL=https://your-domain.com
# WECOM_SECRET 只保存在服务器环境变量中，不得提交到 Git。
# WECOM_USER_ID_URL 接收企微 UserId，并在 data 字段返回可匹配 employee_no 的账号。
# 可信域名必须与 WECOM_CALLBACK_URL 的域名和端口完全一致。

# AI 问数 SSO 配置
SSO_CLIENT_ID=your_sso_client_id
SSO_PLATFORM_URL=https://sso.example.com
SSO_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"
# 使用字面量 \\n 即可，服务启动时会还原为 PEM 换行；启用 SSO 时必须配置完整公钥。

# 外部 HR 人员搜索服务。未配置时接口明确返回 503，不使用隐藏内网默认地址。
HR_API_URL=http://hr.example.com:8500
