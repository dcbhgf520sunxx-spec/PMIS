PORT=3103
DB_HOST=localhost
DB_PORT=5433
DB_USER=pms
DB_PASSWORD=pms123456
DB_NAME=pmis
JWT_SECRET=your_jwt_secret_key_change_this
ALLOWED_ORIGIN=http://localhost:3104
PUBLIC_APP_ORIGIN=http://localhost:3104
# OSS 文件签名密钥；正式环境建议使用独立的 32 字节以上随机值，未配置时兼容复用 JWT_SECRET。
FILE_URL_SIGNING_SECRET=replace_with_at_least_32_random_bytes
CONTRACT_ATTACHMENT_OSS_UPLOAD_URL=http://oss.example.com:8401/oss/file/upload
CONTRACT_ATTACHMENT_OSS_FILE_ORIGIN=http://oss.example.com:9000
# 正式环境由 systemd 固定为 /opt/pmis/shared/private-uploads，本地不配置时使用 backend/private-uploads。
# PMIS_PRIVATE_UPLOAD_ROOT=/opt/pmis/shared/private-uploads

# 企业微信工作台单点登录
WECOM_CORP_ID=ww_your_corp_id
WECOM_AGENT_ID=your_agent_id
WECOM_SECRET=your_wecom_app_secret
WECOM_USER_ID_URL=http://your-internal-service/shr/person/getWxUserId
WECOM_CALLBACK_URL=https://your-domain.com/api/auth/wecom/callback
WECOM_FRONTEND_URL=https://your-domain.com
# WECOM_SECRET 只保存在服务器环境变量中，不得提交到 Git。
# WECOM_USER_ID_URL 接收企微 UserId，并在 data 字段返回可匹配 employee_no 的账号。
# 可信域名必须与 WECOM_CALLBACK_URL 的域名和端口完全一致。

# AI 问数 SSO 配置
SSO_CLIENT_ID=your_sso_client_id
SSO_PLATFORM_URL=https://sso.example.com
SSO_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"
# 支持完整 PEM（换行使用字面量 \\n）或不含头尾的 Base64 SPKI 公钥。

# 外部 HR 人员搜索服务。未配置时接口明确返回 503，不使用隐藏内网默认地址。
HR_API_URL=http://hr.example.com:8500

# 内网智能体 MCP。多个来源用英文逗号分隔；非浏览器 MCP 客户端通常不发送 Origin。
MCP_ALLOWED_ORIGINS=http://localhost:3104
MCP_QUERY_RATE_LIMIT=240
MCP_ACTION_RATE_LIMIT=60
# MCP 文件操作只接受受信 OSS/PMIS URL，多个额外来源用英文逗号分隔。
MCP_FILE_URL_ALLOWED_ORIGINS=http://localhost:3104
MCP_FILE_INLINE_LIMIT=5242880
# Agent返回给用户的短时附件下载地址；生产环境必须填写PMIS对外HTTPS根地址。
MCP_PUBLIC_BASE_URL=http://localhost:3104
MCP_FILE_DOWNLOAD_TTL_SECONDS=300
# 可选独立签名密钥；未配置时复用JWT_SECRET，禁止提交真实密钥。
# MCP_FILE_DOWNLOAD_SECRET=replace_with_a_long_random_secret
# MCP 员工身份 RSA-OAEP 私钥 PEM 的 Base64；只保存在服务端，不得提交私钥原文。
MCP_EMPLOYEE_RSA_PRIVATE_KEY_BASE64=base64_encoded_pkcs8_private_key_pem
# MCP 员工身份短时凭证 HMAC 密钥；服务端与受信平台各保存一份，不得写入代码或聊天。
MCP_EMPLOYEE_ASSERTION_SECRET=replace_with_at_least_32_random_bytes
# 平滑升级期间保持 true；Query/Action 均切换 v3 并验证后改为 false。
MCP_EMPLOYEE_LEGACY_IDENTITY_ENABLED=true
